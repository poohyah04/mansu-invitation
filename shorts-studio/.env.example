# 필수 — https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-...

# 선택 — 구간 분석에 쓸 모델 (기본 claude-opus-5)
# SHORTS_MODEL=claude-opus-5

# 선택 — whisper 실행 파일과 ggml 모델 경로.
# 비워 두면 PATH 에서 whisper-cli / whisper-cpp / whisper 를 찾고,
# 모델은 models/ 폴더의 첫 .bin 파일을 씁니다.
# WHISPER_BIN=/opt/homebrew/bin/whisper-cli
# WHISPER_MODEL=./models/ggml-large-v3-turbo.bin

# 선택 — ffmpeg 가 PATH 에 없을 때만
# FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
# FFPROBE_BIN=/opt/homebrew/bin/ffprobe
